{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "scope",
    "passed",
    "comparisons",
    "rowsImproved",
    "checks"
  ],
  "properties": {
    "job": {
      "const": "B03"
    },
    "scope": {
      "type": "string"
    },
    "passed": {
      "const": true
    },
    "comparisons": {
      "const": 84
    },
    "rowsImproved": {
      "const": 20
    },
    "checks": {
      "type": "array",
      "minItems": 84,
      "maxItems": 84,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pass",
          "quoteId",
          "sourceUrl",
          "quote",
          "bodySha256",
          "presentInRetainedArticle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MG[0-9]{3}$"
          },
          "pass": {
            "enum": [
              1,
              2
            ]
          },
          "quoteId": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "bodySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "presentInRetainedArticle": {
            "const": true
          }
        }
      }
    }
  }
}
