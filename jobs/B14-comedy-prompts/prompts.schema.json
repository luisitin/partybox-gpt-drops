{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B14 final adult fiction prompt pack",
  "type": "array",
  "minItems": 1200,
  "maxItems": 1200,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "kind",
      "text",
      "namedReferences",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[QM][0-9]{4}$"
      },
      "kind": {
        "enum": [
          "fill",
          "most-likely"
        ]
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 90
      },
      "namedReferences": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "confidence": {
        "enum": [
          "high",
          "medium"
        ]
      }
    }
  }
}
