{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edition",
    "sources",
    "rows"
  ],
  "properties": {
    "edition": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "author",
          "url",
          "quotes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "quotes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "difficulties",
          "claim",
          "status",
          "confidence",
          "evidence",
          "scope",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "difficulties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "easy",
                "normal",
                "hard",
                "master"
              ]
            }
          },
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified-fact",
              "corroborated-report",
              "conflicting-reports",
              "unverified"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "quote"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "scope": {
            "type": "string"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
