{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:partybox:B13:trivia-schema",
  "title": "B13 1000 sourced trivia questions",
  "type": "array",
  "minItems": 1000,
  "maxItems": 1000,
  "items": {
    "$ref": "#/$defs/row"
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "question",
        "difficulty",
        "options",
        "correctIndex",
        "correctAnswer",
        "funFact",
        "confidence",
        "confidenceReason",
        "sources",
        "claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B13-[0-9]{4}$"
        },
        "category": {
          "enum": [
            "us-geography",
            "world-geography",
            "science-space",
            "animals-nature",
            "us-history-civics",
            "world-history",
            "movies-tv",
            "music",
            "sports-games",
            "food-everyday-life"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1
        },
        "funFact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "confidenceReason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "url",
              "publisher",
              "quote"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z-]+-s[0-9]{4}$"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "funFactQuote": {
                "type": "string",
                "minLength": 1
              },
              "extraQuote": {
                "type": "string",
                "minLength": 1,
                "description": "Additional contiguous <=25-word answer-scope support, checked by the same actual capture and fresh-review gates."
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text",
              "sourceIds"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "answer",
                  "funFact"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
