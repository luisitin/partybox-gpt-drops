          "text": "red on the second floor"
        },
        {
          "id": "W_GALLERIA-Q037",
          "text": "Every fifth turn"
        },
        {
          "id": "W_GALLERIA-Q038",
          "text": "The flash sale lasts one turn."
        },
        {
          "id": "W_GALLERIA-Q039",
          "text": "on the third turn when playing with Frenzy Rules"
        },
        {
          "id": "W_GALLERIA-Q040",
          "text": "rounded down"
        },
        {
          "id": "W_GALLERIA-Q041",
          "text": "This occurs on the 10th turn of 12 turns."
        },
        {
