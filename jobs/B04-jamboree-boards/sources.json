          "text": "twice its original cost in the shop"
        },
        {
          "id": "W_GALLERIA-Q033",
          "text": "Whomp buys for 20 coins"
        },
        {
          "id": "W_GALLERIA-Q034",
          "text": "one drawing per item purchased"
        },
        {
          "id": "W_GALLERIA-Q035",
          "text": "1, 5, 15, 30 coins, or a Golden Pipe"
        },
