{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noEmitOnError": true,
    "declaration": true, "outDir": "dist", "rootDir": ".", "skipLibCheck": false
  },
  "include": ["motion.ts", "tests/reference.ts"]
}
