{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022"], "types": [],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "noEmitOnError": true, "rootDir": "server", "outDir": "../.verification/partybox-build"
  },
  "include": ["server/**/*.ts"]
}
